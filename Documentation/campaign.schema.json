{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SortScape campaign v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatorVersion", "levels"],
  "properties": {
    "schemaVersion": {"const": 2},
    "generatorVersion": {"const": 1},
    "levels": {
      "type": "array", "minItems": 100, "maxItems": 100,
      "items": {"$ref": "#/$defs/level"}
    }
  },
  "$defs": {
    "recipe": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "seed", "colors", "emptyContainers"],
      "properties": {
        "version": {"enum": [0, 1]},
        "seed": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "colors": {"type": "integer", "minimum": 2, "maximum": 4},
        "emptyContainers": {"type": "integer", "minimum": 1, "maximum": 2}
      }
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["solutionLength", "solverEffort", "complexity", "score"],
      "properties": {
        "solutionLength": {"type": "integer", "minimum": 1, "maximum": 128},
        "solverEffort": {"type": "integer", "minimum": 1, "maximum": 200000},
        "complexity": {"type": "integer", "minimum": 0, "maximum": 64},
        "score": {"type": "integer", "minimum": 0, "maximum": 1000}
      }
    },
    "level": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "tier", "containers", "recipe", "metrics"],
      "properties": {
        "id": {"type": "integer", "minimum": 1, "maximum": 100},
        "name": {"type": "string", "minLength": 1},
        "tier": {"enum": ["beginner", "easy", "medium", "hard", "expert"]},
        "containers": {
          "type": "array", "minItems": 3, "maxItems": 6,
          "items": {"type": "array", "maxItems": 4, "items": {"type": "integer", "minimum": 0, "maximum": 3}}
        },
        "recipe": {"$ref": "#/$defs/recipe"},
        "metrics": {"$ref": "#/$defs/metrics"}
      }
    }
  }
}
